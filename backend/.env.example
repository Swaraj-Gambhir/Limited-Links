# Azure AD Application (Client) ID
AZURE_AD_CLIENT_ID="YOUR_AZURE_AD_CLIENT_ID"
# Azure AD Directory (Tenant) ID
AZURE_AD_TENANT_ID="YOUR_AZURE_AD_TENANT_ID"
# Azure AD Client Secret
AZURE_AD_CLIENT_SECRET="YOUR_AZURE_AD_CLIENT_SECRET"

# Backend specific settings (optional, for example)
API_V1_STR="/api/v1"

# SharePoint Integration - via Microsoft Graph API
# The existing AZURE_AD_CLIENT_ID, AZURE_AD_TENANT_ID, AZURE_AD_CLIENT_SECRET will be used for Graph API authentication
SHAREPOINT_HOSTNAME="YOUR_SHAREPOINT_HOSTNAME" # e.g., "yourtenant.sharepoint.com"
SHAREPOINT_SITE_NAME="YOUR_SHAREPOINT_SITE_NAME" # e.g., "sites/MyTeamSite" or just "MyTeamSite" if under /sites/
SHAREPOINT_DOCLIB_NAME="Shared Documents" # Or your specific document library name

# For Temporary View Links
VIEW_TOKEN_SECRET_KEY="generate_a_strong_random_secret_for_view_tokens"
VIEW_TOKEN_EXPIRE_MINUTES=15
